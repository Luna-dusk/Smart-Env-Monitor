# ── 目标芯片 / Flash ─────────────────────────────────────────────
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# 自定义分区表（factory 4MB：装得下中文全量字库）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-16MiB.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions-16MiB.csv"

# ── PSRAM 8MB（ESP32-S3-WROOM-1-N16R8）───────────────────────────
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# ── LVGL（ST7789 SPI 屏，components/BSP/LCD/）────────────────────
# ST7789 按字节流收 RGB565，LVGL 内存里默认小端，必须编译期换字节序，
# 否则颜色像负片（LCD/README.md 4.3 / 9.⑤）
CONFIG_LV_COLOR_16_SWAP=y
# 图标走 LVGL 内置 Montserrat 的符号区（LV_SYMBOL_*）
# 14 给 LV_SYMBOL 图标，24/28/48 给仪表盘数字：
#   48 = 时钟 12:34；28 = 温湿度大数值；24 = 空气三值 + 闹钟时间
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# 全量中文字库（16px，约 2.7MB，>10k 字形）必须开，否则生成物里的 #error 会中断构建
CONFIG_LV_FONT_FMT_TXT_LARGE=y
# LVGL 内存池放 PSRAM（不要那 32KB 静态 .bss）
# 分配函数在 components/BSP/LCD/lv_mem_psram.h，由根 CMakeLists.txt 的
# add_compile_definitions() 注入成 LV_MEM_CUSTOM_ALLOC/FREE/REALLOC。
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_CUSTOM_INCLUDE="lv_mem_psram.h"